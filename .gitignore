# ─────────────────────────────────────────
#  Neighborhood Sustainability Hub .gitignore
# ─────────────────────────────────────────

# ── Dependencies ──────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Environment Variables (NEVER commit) ──
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local

# ── Next.js Build Output ──────────────────
.next/
out/
dist/
build/

# ── Supabase ──────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/config.toml.bak

# ── Testing ───────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Logs ──────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS Files ──────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor & IDE ──────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── TypeScript ────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Project-specific temp & debug files ───
tmp*.ts
tmp*.txt
tsc*.txt
tsc*.log
typescript-errors*.txt
test-db.js
.env.local.example.bak
errors.json
extracted-db*.txt
run_check.ts

# ── Misc ──────────────────────────────────
.cache/
.temp/
.tmp/
vercel.json.local
.vercel

# ── Python ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/

