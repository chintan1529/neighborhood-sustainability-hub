# ─────────────────────────────────────────────────────────────
#  Neighborhood Sustainability Hub — Environment Variables
#  Copy this file to .env.local and fill in your actual values.
#  NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI / Hugging Face ─────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_token_here

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Neighborhood Sustainability Hub

# ── Prediction Engine Tuning (optional) ───────────────────────
PREDICTION_CONFIDENCE_THRESHOLD=0.6
PREDICTION_TARGET_HOURS=24
PREDICTION_FEEDBACK_HOURS=24
PREDICTION_PAI_DECAY=0.85
PREDICTION_PAI_WINDOW=10
PREDICTION_PAI_TARGET=0.8
